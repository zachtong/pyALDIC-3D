# Normalize all text to LF in the repo AND the working tree, so Windows
# checkouts, Linux/macOS CI and every editor agree — without it, autocrlf=true
# would check out CRLF on Windows and every file would churn on first commit.
* text=auto eol=lf

# Binary assets: no EOL conversion, no textual diffs.
*.png  binary
*.jpg  binary
*.pdf  binary
*.qm   binary
*.mat  binary
*.npz  binary
*.aldic3d binary
