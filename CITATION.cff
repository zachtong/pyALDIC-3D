    given-names: Zixiang
    alias: Zach
    email: zachtong@utexas.edu
    affiliation: The University of Texas at Austin
    orcid: "https://orcid.org/0009-0008-6807-0757"
license: BSD-3-Clause
version: 1.0.2
date-released: "2026-07-29"
repository-code: "https://github.com/zachtong/pyALDIC-3D"
url: "https://github.com/zachtong/pyALDIC-3D"
doi: 10.5281/zenodo.21696564
identifiers:
  - type: doi
    value: 10.5281/zenodo.21696564
    description: Zenodo concept DOI (all versions)
keywords:
  - digital image correlation
  - DIC
  - stereo DIC
  - 3D DIC
  - stereo
  - experimental mechanics
  - strain measurement
  - photogrammetry
  - triangulation
references:
  - type: article
    title: 3D Stereo Adaptive Mesh Augmented Lagrangian Digital Image Correlation
    authors:
      - family-names: Tong
        given-names: Zixiang
      - family-names: Yang
        given-names: Jin
    journal: Experimental Mechanics
    year: 2025
    doi: 10.1007/s11340-025-01225-7
    notes: The MATLAB reference implementation this software ports.
  - type: article
    title: >-
      pyALDIC: A Python Implementation of Augmented Lagrangian Digital Image
      Correlation with a GUI, Adaptive Meshing, and Mask-Aware Subset Splitting
    authors:
      - family-names: Tong
        given-names: Zixiang
      - family-names: Yang
        given-names: Jin
    year: 2026
    doi: 10.48550/arXiv.2607.22755
    url: "https://arxiv.org/abs/2607.22755"
    notes: >-
      Preprint (under review) describing the pyALDIC 2D platform (al-dic) this
      application builds on.
